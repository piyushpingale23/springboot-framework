<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">


    <!-- ===================================================== -->
    <!-- SETTER-BASED INJECTION (Property Injection) -->
    <!-- ===================================================== -->

    <!-- Bean 1: Setter-based injection + Singleton scope (default) -->
    <bean class="bean_creation.xml.setter.Car" id="carSetter1">
        <!-- Spring will call setCarModel("Tesla") -->
        <property name="carModel" value="Tesla-Setter-Based" />

        <!-- Spring will call setCarType("Petrol") -->
        <property name="carType" value="Petrol-Setter-Based" />
    </bean>

    <!-- Bean 3: Setter-based injection + Prototype scope -->
    <bean class="bean_creation.xml.setter.Car" id="carSetter2" scope="prototype">
        <property name="carModel" value="Audi-Setter-Based" />
        <property name="carType" value="Electric-Setter-Based" />
    </bean>


    <!-- ===================================================== -->
    <!-- CONSTRUCTOR-BASED INJECTION -->
    <!-- ===================================================== -->

    <!-- Bean 3: Constructor-based injection + Singleton scope (default) -->
    <bean class="bean_creation.xml.constructor.Car" id="carConstructor1">
        <!-- Spring will call: new Car("Tesla", "Petrol") -->
        <constructor-arg value="Tesla-Constructor-Based" />
        <constructor-arg value="Petrol-Constructor-Based" />
    </bean>

    <!-- Bean 4: Constructor-based injection + Prototype scope -->
    <bean class="bean_creation.xml.constructor.Car" id="carConstructor2" scope="prototype">
        <constructor-arg value="Audi-Constructor-Based" />
        <constructor-arg value="Diesel-Constructor-Based" />
    </bean>

    <!-- Bean Scope examples -->
    <bean class="bean_scope.singleton.Car" id="car">
        <property name="carModel" value="Tesla" />
        <property name="carType" value="Petrol" />
    </bean>

    <bean class="bean_scope.prototype.Bike" id="bike" scope="prototype">
        <property name="bikeModel" value="Avenger" />
        <property name="bikeType" value="Petrol" />
    </bean>

</beans>